# Copiar a .env y completar las contraseñas. .env no se versiona.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=reservas
MYSQL_USER=reservas
MYSQL_PASSWORD=
# La API se publica solo en 127.0.0.1. Con 0.0.0.0 acepta conexiones de otros equipos de la red.
API_HOST=127.0.0.1
API_PORT=8080
# MySQL se publica solo en 127.0.0.1, para conectarse con un cliente local.
MYSQL_PORT=3306
